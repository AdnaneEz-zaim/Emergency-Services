<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:background="@drawable/shape_dialog"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:layout_gravity="center"
    >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Network Not Available"
        android:textSize="24dp"
        android:gravity="center"
        android:textColor="@color/colorApp"
        android:textStyle="bold"
        />
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/network_not_valable"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="please change your network connection type"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="#656363"
        android:textSize="15dp"
        />
    <TextView
        android:id="@+id/dialog_Exit"
        android:text="EXIT"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="100dp"
        android:gravity="center"
        android:layout_width="match_parent"
        android:background="@drawable/discount_shape"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_height="40dp"/>
</LinearLayout>