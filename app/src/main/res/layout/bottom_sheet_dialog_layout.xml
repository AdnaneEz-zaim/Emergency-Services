<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:background="@drawable/rounded_dialog"
    android:layout_height="match_parent">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Emergency Title"
        android:id="@+id/titleEmergency"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/colorApp"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/download"
        android:background="?android:attr/selectableItemBackground"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date :"
            android:textSize="15dp"
            android:textColor="@color/colorApp"
            android:padding="8dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25/08/2022 08:17"
            android:id="@+id/EmergencyDate"
            android:layout_gravity="center_vertical"
            android:paddingStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/shareLinearLayout"
        android:background="?android:attr/selectableItemBackground"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15dp"
            android:textColor="@color/colorApp"
            android:text="Danger Level :"
            android:layout_gravity="center_vertical"
            android:padding="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High"
            android:id="@+id/EmergencyLevelDanger"
            android:textColor="#E91E63"
            android:layout_gravity="center_vertical"
            android:padding="8dp"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/uploadLinearLaySout"
        android:background="?android:attr/selectableItemBackground"
        >

        <TextView
            android:textSize="15dp"
            android:textColor="@color/colorApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Injured number:"
            android:layout_gravity="center_vertical"
            android:padding="8dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08"
            android:id="@+id/EmergencyNumberInjured"
            android:textColor="#E91E63"
            android:layout_gravity="center_vertical"
            android:padding="8dp"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?android:attr/selectableItemBackground"
        >
        <TextView
            android:textSize="15dp"
            android:textColor="@color/colorApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Position name:"
            android:layout_gravity="center_vertical"
            android:padding="8dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08"
            android:id="@+id/EmergencyPositionName"
            android:layout_gravity="center_vertical"
            android:padding="8dp"/>

    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Description"
        android:layout_marginBottom="3dp"
        android:textSize="13sp"
        />
    <TextView
        android:layout_width="match_parent"
        android:id="@+id/EmergencyDescription"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2sp"
        android:scrollbars="vertical"
        android:textColor="#494947"
        android:textSize="12sp"
        android:text="description description description description description description descrip description description description description description description description description description description description description description description description description description description description description description description description description description "
        />
    <TextView
        android:id="@+id/takeBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorApp"
        android:textAlignment="center"
        android:text="SELECT POSITION"
        android:textColor="@color/white"
        android:padding="12dp"
        android:clickable="true"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        />
</LinearLayout>